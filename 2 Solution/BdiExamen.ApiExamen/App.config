<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="ExamenSqlDirecto"
         connectionString="Data Source=.\SQLExpress;Initial Catalog=BdiExamen;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="WsApiexamenBaseUrl" value="https://localhost:44352" />
  </appSettings>
</configuration>